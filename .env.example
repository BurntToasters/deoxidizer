# NOTE: .env is NOT auto-loaded by deoxidizer release scripts (unlike iyeris,
# which uses dotenv). Source it manually per shell, e.g.:
#   set -a; source .env; set +a
# GitHub releases use the GitHub CLI credential store. Run `gh auth login` on
# each release VM; no GitHub token belongs in this file.
GH_REPO_OWNER=BurntToasters
GH_REPO_NAME=deoxidizer
DEOX_RELEASE_CONFIRM=
DEOX_RELEASE_DRAFT_MODE=create
# Draft wait polling for builders in --wait mode (ms). Guarded with
# Number.isFinite fallbacks in ensure-draft-release.cjs.
RELEASE_DRAFT_WAIT_TIMEOUT_MS=
RELEASE_DRAFT_WAIT_POLL_MS=
DEOX_ALLOW_UNSIGNED_RELEASE=0
DEOX_CHECKSUM_NAME=
# Internal/advanced: set by release tooling to bind the release session target
# (e.g. host); do not set manually.
# DEOX_RELEASE_TARGET=

# GPG key ID / fingerprint for signing release artifacts
GPG_KEY_ID=

# GPG passphrase for non-interactive (CI) signing
GPG_PASSPHRASE=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust)
# Once per Windows release VM (as Administrator), run:
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-artifact-signing.ps1
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# exact signing cert Subject DN
#   AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=CN=Your Name, O=Your Org, C=US
# Tip after a signed build:
#   (Get-AuthenticodeSignature .\deoxidizer.exe).SignerCertificate.Subject
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

# macOS codesigning & notarization:
# Certificate identity from Keychain (e.g. "Developer ID Application: Name (TEAMID)")
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
# Name of a notarytool keychain profile created before release signing.
APPLE_KEYCHAIN_PROFILE=

# Override repo owner/name (defaults to BurntToasters/deoxidizer)
# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=deoxidizer
